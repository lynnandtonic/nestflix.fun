extends _includes/skeleton

block vars 
    - var title = "Reality & Documentary";
    - var description = "Reality and documentary films and shows within other films and shows.";
    - var bodyClass = "category";

include _includes/mixin-feature
include _includes/mixin-cards
include _includes/mixin-entry-img

block content
    section.hero
        +entry-img('Looking for LaToya')
        +entry-img('Hot Shot')
        +entry-img('The Wives of Wall Street')
        +entry-img('Party Monster: Scratching the Surface')
        +entry-img('Green Queen')
        .info
            h1 Reality & Documentary on Nestflix

    span#content

    - var tags = ['reality tv', 'beauty and makeover', 'funny videos and home movies', 'prank shows', 'reality competition shows', 'reality dating shows', 'documentaries', 'documentary series', 'food and cooking', 'criminal justice reality tv', 'home, diy, and art', 'educational videos', 'self-improvement', 'paranormal investigation', 'animals on tv' ];

    +cards(0,4)
    +feature('Party Monster: Scratching the Surface')(class='feature-1 top')
    +feature('Lair of Love')(class='feature-2')
    +feature('Unfiction')(class='feature-3 top')
    +cards(4,7)
    +feature('Sick, Sad World')(class='feature-1')
    +feature('Green Queen')(class='feature-2')
    +feature('Big Shot')(class='feature-3 top')
    +cards(7,12)
    +feature('Repo Divorcées')(class='feature-1 top')
    +feature('Looking for LaToya')(class='feature-2 top')
    +feature('The Life Aquatic Adventure No. 12: The Jaguar Shark (Part 1)')(class='feature-3')
    +cards(12,15)
